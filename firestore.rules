rules_version = '2';
// Partidas compartidas de Anno 117 · Cadenas.
// El código de la partida (10 caracteres aleatorios) es la llave: quien lo tiene, juega.
// Solo usuarios con sesión (anónima) y solo dentro de /games/{code}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{code}/{document=**} {
      allow read, write: if request.auth != null && code.matches('^[A-Z2-9]{10}$');
    }
  }
}
